<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTAINER KONTEN UTAMA -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ================= TAB 1: MENU UTAMA ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutMenuUtama"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Menu Utama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Penerus Otomatis Chat ke OLED ESP32"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- KARTU STATUS KONEKSI ESP32 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/text_muted"
                            android:contentDescription="Status Bluetooth" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_ble_status"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/status_connecting" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvBleStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_connecting"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBleDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perangkat: ESP32-SmartNotif (Auto-Sync)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- KARTU FILTER APLIKASI YANG DITERUSKAN (DI MENU UTAMA) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_filter_list"
                            app:tint="@color/primary"
                            android:contentDescription="Filter Notifikasi" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Filter Aplikasi yang Diteruskan"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchWA"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_wa"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector"
                            android:checked="true" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTelegram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_telegram"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSMS"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_sms"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector"
                            android:checked="true" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchIG"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_ig"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- KARTU TES KIRIM PESAN MANUAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_test_send"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_test_title"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/card_bg_elevated"
                        app:boxStrokeColor="@color/card_stroke"
                        app:hintTextColor="@color/text_secondary"
                        android:textColorHint="@color/text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTestSender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:text="Budi"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_test_msg"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/card_bg_elevated"
                        app:boxStrokeColor="@color/card_stroke"
                        app:hintTextColor="@color/text_secondary"
                        android:textColorHint="@color/text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTestMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:text="Halo! Ini tes notifikasi langsung ke ESP32" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendTest"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:text="@string/btn_send_test"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestSyncTime"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="Tes [TIME]"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/card_bg_elevated"
                            android:elevation="2dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestSyncWeather"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:text="Tes [WEATHER]"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/card_bg_elevated"
                            android:elevation="2dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTestNav"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="Tes [NAV]"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/card_bg_elevated"
                            android:elevation="2dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- KARTU LOG NOTIFIKASI REAL-TIME -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvLogsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/title_live_logs"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hapus Log"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="14dp"
                            app:iconTint="@color/text_secondary"
                            android:padding="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEmptyLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_empty"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNotifLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_notif_log" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= TAB 2: SETTING ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutSetting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengaturan dan Izin"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelola akses notifikasi sistem, izin keamanan, dan Bluetooth"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- SEKSI 1: AKSES NOTIFIKASI & IZIN SISTEM (DI SETTING) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_notifications_active"
                            app:tint="@color/primary"
                            android:contentDescription="Izin Notifikasi" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Akses Notifikasi Android"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNotifStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum Aktif"
                            android:textColor="@color/status_connecting"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/card_stroke" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aplikasi memerlukan izin ini agar dapat meneruskan isi pesan masuk ke layar OLED ESP32."
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:layout_marginBottom="14dp" />

                    <!-- Tombol Utama: Buka Pengaturan Akses Notifikasi -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuNotifAccess"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Buka Akses Notifikasi"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_notifications_active"
                        app:iconGravity="textStart"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/primary"
                        android:layout_marginBottom="14dp" />

                    <!-- KOTAK PANDUAN KHUSUS SETELAN TERBATAS (ANDROID 13/14+) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_floating"
                        android:elevation="2dp"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_warning_amber"
                                android:contentDescription="Perhatian" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Jika Saklar Notifikasi Abu-abu / Terkunci:"
                                android:textColor="#B87A28"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Di halaman Akses Notifikasi, ketuk saklar ESP32 Smart Notif hingga muncul dialog Setelan Terbatas, lalu tekan OK.\n2. Buka Pengaturan HP -> Aplikasi -> Lihat semua aplikasi -> ESP32 Smart Notif.\n3. Tekan tombol titik tiga di pojok kanan atas, lalu pilih Izinkan setelan terbatas.\n4. Kembali ke Akses Notifikasi dan aktifkan saklarnya."
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <!-- Tombol Buka Info Aplikasi -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuAppInfo"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Buka Info Aplikasi"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        app:icon="@drawable/ic_app_settings"
                        app:iconGravity="textStart"
                        app:iconTint="@color/text_primary"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp"
                        app:backgroundTint="@color/card_bg_elevated"
                        android:elevation="2dp" />
                </LinearLayout>

                <!-- SEKSI 2: KONEKSI BLUETOOTH & DEVICE INFO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <!-- Header Seksi Bluetooth -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/primary"
                            android:contentDescription="Bluetooth ESP32" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Koneksi Bluetooth ESP32"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pindai dan pilih perangkat ESP32-C3 di sekitar Anda untuk dihubungkan."
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:layout_marginBottom="14dp" />

                    <!-- KOTAK STATUS PERANGKAT SAAT INI (FLOATING WHITE) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_card_floating"
                        android:elevation="2dp"
                        android:padding="14dp"
                        android:layout_marginBottom="14dp">

                        <View
                            android:id="@+id/viewSettingBleDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/status_disconnected" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvSettingDeviceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tidak Ada Perangkat Terhubung"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSettingDeviceAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tekan Mulai Pindai untuk mendeteksi ESP32-C3"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisconnectBle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Putuskan"
                            android:textColor="@color/status_disconnected"
                            android:textSize="11sp"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/status_disconnected"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@android:color/transparent"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- SWITCH FILTER KHUSUS ESP32 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saring Khusus ESP32 / ESP32-C3"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hanya tampilkan modul ESP32 di daftar hasil scan"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchFilterEspOnly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- TOMBOL MULAI PINDAI -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuRescanBle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Mulai Pindai Bluetooth"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:cornerRadius="14dp"
                        app:backgroundTint="@color/primary"
                        android:layout_marginBottom="10dp" />

                    <!-- PROGRESS BAR PEMINDAIAN -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pbScanLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/card_stroke"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvScanStatusInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memindai perangkat Bluetooth ESP32-C3 di sekitar..."
                        android:textColor="@color/status_connecting"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp" />

                    <!-- LABEL DAFTAR PERANGKAT TERSEDIA -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERANGKAT TERSEDIA"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <!-- EMPTY STATE -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyBleDevices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/text_muted"
                            android:alpha="0.4"
                            android:contentDescription="No Devices" />

                        <TextView
                            android:id="@+id/tvEmptyBleDevicesMsg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum ada perangkat terdeteksi.\nTekan 'Mulai Pindai Bluetooth' untuk mendeteksi ESP32-C3."
                            android:textColor="@color/text_muted"
                            android:textSize="11.5sp"
                            android:textAlignment="center"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                    <!-- RECYCLERVIEW DAFTAR PERANGKAT BLE -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBleDevices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- GARIS PEMISAH ATAS NAVBAR -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION BAR (NAVBAR DI BAWAH) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
