<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- CONTAINER KONTEN UTAMA -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ================= TAB 1: MENU UTAMA ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutMenuUtama"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Menu Utama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Penerus Otomatis Chat ke OLED ESP32"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- KARTU STATUS KONEKSI ESP32 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/text_muted"
                            android:contentDescription="Status Bluetooth" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/title_ble_status"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_badge"
                            android:backgroundTint="@color/status_connecting" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvBleStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_connecting"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBleDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perangkat: ESP32-SmartNotif (Auto-Sync)"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Peringatan Akses Notifikasi Belum Aktif -->
                <LinearLayout
                    android:id="@+id/layoutPermissionWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_warning_amber"
                            android:contentDescription="Peringatan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Akses Notifikasi Belum Diizinkan"
                            android:textColor="#F59E0B"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buka tab Setting di bawah untuk mengaktifkan izin notifikasi atau membuka izin setelan terbatas."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickGrantNotif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Aktifkan Akses Notifikasi"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_notifications_active"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

                <!-- KARTU TES KIRIM PESAN MANUAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_test_send"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_test_title"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/card_stroke"
                        app:hintTextColor="@color/primary"
                        android:textColorHint="@color/text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTestSender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:text="Budi"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hint_test_msg"
                        app:boxBackgroundColor="@color/background"
                        app:boxStrokeColor="@color/card_stroke"
                        app:hintTextColor="@color/primary"
                        android:textColorHint="@color/text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTestMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:text="Halo! Ini tes notifikasi langsung ke ESP32" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_send_test"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

                <!-- KARTU LOG NOTIFIKASI REAL-TIME -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvLogsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/title_live_logs"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hapus Log"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_delete"
                            app:iconSize="14dp"
                            app:iconTint="@color/primary"
                            android:padding="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEmptyLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/logs_empty"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNotifLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_notif_log" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= TAB 2: SETTING ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutSetting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Setting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengaturan dan Izin"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelola izin keamanan sistem, filter notifikasi, dan Bluetooth"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- SEKSI 1: IZIN & KEAMANAN SISTEM -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_shield_security"
                            app:tint="@color/primary"
                            android:contentDescription="Izin Sistem" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Izin dan Keamanan Android"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tombol Buka Info Aplikasi untuk Setelan Terbatas -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuAppInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Buka Info Aplikasi (Buka Setelan Terbatas)"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_app_settings"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#D97706"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khusus Android 13+: Tekan menu titik tiga di halaman Info Aplikasi lalu pilih Izinkan setelan terbatas agar akses notifikasi dapat diaktifkan."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Tombol Akses Notifikasi -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuNotifAccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pengaturan Akses Notifikasi"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_notifications_active"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

                <!-- SEKSI 2: FILTER APLIKASI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_filter_list"
                            app:tint="@color/primary"
                            android:contentDescription="Filter Notifikasi" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Filter Notifikasi Aplikasi"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchWA"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_wa"
                            android:textColor="@color/text_primary"
                            android:checked="true" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTelegram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_telegram"
                            android:textColor="@color/text_primary"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSMS"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_sms"
                            android:textColor="@color/text_primary"
                            android:checked="true" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchIG"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_ig"
                            android:textColor="@color/text_primary"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SEKSI 3: KONEKSI BLUETOOTH & DEVICE INFO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/primary"
                            android:contentDescription="Bluetooth ESP32" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Koneksi Bluetooth ESP32"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMenuRescanBle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pindai Ulang Bluetooth ESP32"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/card_stroke"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perangkat: ESP32-SmartNotif (Nordic UART Service)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Otomatis memindai dan menghubungkan kembali"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- GARIS PEMISAH ATAS NAVBAR -->
    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION BAR (NAVBAR DI BAWAH) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/bottom_nav_menu"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
