<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar Header dengan Tombol Hamburger (☰) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penerus Otomatis Chat ke OLED ESP32"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Ikon Hamburger Menu (☰) untuk Pengaturan & Titik Tiga -->
            <ImageButton
                android:id="@+id/btnHamburger"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_card"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu Pengaturan"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- KARTU STATUS KONEKSI ESP32 (OTOMATIS & REAL-TIME) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_ble_status"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="@color/status_connecting" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvBleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_connecting"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBleDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perangkat: ESP32-SmartNotif (Auto-Sync)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Peringatan Singkat jika Akses Notifikasi Belum Aktif -->
        <LinearLayout
            android:id="@+id/layoutPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Akses Notifikasi Belum Diizinkan"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka menu Pengaturan (☰) untuk mengaktifkan izin notifikasi atau membuka kunci titik tiga."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickGrantNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aktifkan Akses Notifikasi"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- KARTU TES KIRIM PESAN MANUAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_test_send"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_test_title"
                app:boxBackgroundColor="@color/background"
                app:boxStrokeColor="@color/card_stroke"
                app:hintTextColor="@color/primary"
                android:textColorHint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTestSender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:text="Budi"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_test_msg"
                app:boxBackgroundColor="@color/background"
                app:boxStrokeColor="@color/card_stroke"
                app:hintTextColor="@color/primary"
                android:textColorHint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTestMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:text="Halo! Ini tes notifikasi langsung ke ESP32" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_send_test"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- KARTU LOG NOTIFIKASI REAL-TIME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvLogsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_live_logs"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus Log"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logs_empty"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotifLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_notif_log" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
