<resources>
    <!-- White & Pastel Green Aesthetic Palette (antislop-ui compliant) -->
    <!-- 1. Backgrounds & Surfaces -->
    <color name="background">#F4F9F5</color>             <!-- Light airy pastel mint-white background -->
    <color name="card_bg">#FFFFFF</color>                <!-- Crisp pure white panel -->
    <color name="card_bg_elevated">#FFFFFF</color>       <!-- Crisp pure white floating surface -->
    <color name="card_stroke">#D8EADF</color>            <!-- Soft delicate pastel sage border -->
    <color name="card_stroke_subtle">#EBF4EE</color>     <!-- Ultra-subtle inner divider -->

    <!-- 2. Typography & Iconography -->
    <color name="text_primary">#193324</color>           <!-- Deep forest emerald black (13.7:1 contrast) -->
    <color name="text_secondary">#3B6349</color>         <!-- Soft medium eucalyptus sage (6.1:1 contrast) -->
    <color name="text_muted">#527760</color>             <!-- Muted sage auxiliary (4.8:1 contrast, passes WCAG AA) -->

    <!-- 3. Primary Accents & Buttons -->
    <color name="primary">#327850</color>                <!-- Rich pastel forest green button (5.5:1 contrast) -->
    <color name="primary_variant">#225939</color>        <!-- Deep pine green -->
    <color name="primary_container">#D8F5DD</color>      <!-- Soft pastel mint container tint (Active pill) -->
    <color name="on_primary_container">#184729</color>   <!-- Forest text on mint container (9.1:1 contrast) -->

    <color name="secondary">#46855E</color>              <!-- Medium pastel leaf green -->
    <color name="secondary_variant">#336B49</color>      <!-- Deep leaf green -->
    <color name="accent_warm">#5EA87C</color>            <!-- Gentle pastel mint accent -->

    <!-- 4. Status Indicators (Harmonious Accents, WCAG AA Verified) -->
    <color name="status_connected">#247844</color>       <!-- Pastel lush green (5.5:1 contrast) -->
    <color name="status_disconnected">#C44F43</color>    <!-- Soft pastel terracotta red (4.7:1 contrast) -->
    <color name="status_connecting">#9E6700</color>      <!-- Warm amber bronze (4.7:1 contrast against white) -->

    <!-- 5. Toggles & Component States -->
    <color name="switch_track_active">#46996B</color>    <!-- Pastel green track when ON -->
    <color name="switch_track_inactive">#D5E8DC</color>  <!-- Soft pastel mint-gray track when OFF -->
    <color name="switch_thumb_active">#FFFFFF</color>    <!-- Pure white thumb -->
    <color name="switch_thumb_inactive">#7A9E8D</color>  <!-- Muted sage thumb when OFF -->

    <!-- 6. Base Constants -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="ic_launcher_background">#D8F7CE</color>
